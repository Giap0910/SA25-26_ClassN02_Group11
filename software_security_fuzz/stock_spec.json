{
  "name": "badminton_stock",
  "version": 1,
  "scope": "Một sản phẩm, tối đa một biến thể; không mô hình hóa khóa, giá, voucher và PayOS.",
  "backend_sha256": {
    "OrderService.java": "7c40dc928498fcd79af6bb278f8ce4a0f4b759f1efe76b3af94a99ef9caea53d",
    "ProductVariantService.java": "d19b7c8e5271a2cc005df62b172a773ddeb8655935cd0ff88a1e1c5a0648f6d7"
  },
  "operations": {
    "reserve": [
      {"when": "q < 1 or q > 100", "return": 1},
      {"when": "available < q", "return": 2},
      {"when": "reserved + q > 2147483647", "return": 3},
      {"when": "variant and va < q", "return": 4},
      {"when": "variant and vr + q > 2147483647", "return": 5},
      {"set": "available", "value": "available - q"},
      {"set": "reserved", "value": "reserved + q"},
      {"when": "variant", "set": "va", "value": "va - q"},
      {"when": "variant", "set": "vr", "value": "vr + q"},
      {"set": "state", "value": "1"}
    ],
    "settle": [
      {"when": "state != 1", "return": 0},
      {"when": "reserved < q or (variant and vr < q)", "return": 6},
      {"when": "restore and variant and va + q > 2147483647", "return": 7},
      {"set": "reserved", "value": "reserved - q"},
      {"when": "restore", "set": "available", "value": "q", "mode": "java_add"},
      {"when": "variant", "set": "vr", "value": "vr - q"},
      {"when": "variant and restore", "set": "va", "value": "va + q"},
      {"when": "restore", "set": "state", "value": "2"},
      {"when": "not restore", "set": "state", "value": "3"}
    ]
  },
  "traceability": [
    {"requirement": "REQ-1", "source": "OrderService.validateRequestedItems", "rule": "reserve/quantity", "cases": "TC-1"},
    {"requirement": "REQ-2", "source": "OrderService.validateProductForOrder", "rule": "reserve/available", "cases": "TC-2"},
    {"requirement": "REQ-3", "source": "OrderService reservedStock long guard", "rule": "reserve/reserved", "cases": "TC-3"},
    {"requirement": "REQ-4", "source": "OrderService.cancelOrder; settleReservedStock", "rule": "settle/restore/state", "cases": "TC-4"},
    {"requirement": "REQ-5", "source": "OrderService COD settlement", "rule": "settle/no restore/state", "cases": "TC-5"},
    {"requirement": "REQ-6", "source": "ProductVariantService.reserve", "rule": "reserve/variant", "cases": "TC-6"}
  ],
